# Copy to .env (chmod 600) and fill in only what your config uses. Never commit .env.

# Discord webhook (Server Settings > Integrations > Webhooks)
DISCORD_WEBHOOK_URL=

# OVHcloud (sells .pl): https://eu.api.ovh.com/createToken/
# rights: GET/POST/DELETE /order/cart*, GET /me*, GET /domain/*
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# Telegram bot from @BotFather (chat id goes in config.yaml)
TELEGRAM_BOT_TOKEN=

# Porkbun: https://porkbun.com/account/api (enable API access per domain/account)
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# Cloudflare Registrar: API token with Registrar write permission
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Namecheap: Profile > Tools > API Access (whitelist the IP you call from)
NAMECHEAP_API_USER=
NAMECHEAP_API_KEY=
NAMECHEAP_USERNAME=
NAMECHEAP_CLIENT_IP=

# Optional
# DROPCATCH_CONFIG=/etc/dropcatch/config.yaml
# DROPCATCH_METRICS_TOKEN=long-random-string   # lets remote Prometheus scrape /metrics
# PROXY_BACKUP_URL=http://user:password@proxy.example:3128
