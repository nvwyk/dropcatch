{
  "name": "dropcatch",
  "version": "0.2.0",
  "description": "Domain drop watcher and safe auto-buyer for Node.js. Adaptive polling around a known release time, multi-provider availability, budget-gated registration, Discord alerts and a full SQLite audit trail.",
  "type": "module",
  "license": "MIT",
  "author": "nvwyk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nvwyk/dropcatch.git"
  },
  "homepage": "https://github.com/nvwyk/dropcatch#readme",
  "bugs": {
    "url": "https://github.com/nvwyk/dropcatch/issues"
  },
  "bin": {
    "dropcatch": "dist/index.js",
    "domain-drop": "dist/index.js"
  },
  "files": [
    "dist",
    "dashboard/public",
    "config/example.yaml",
    ".env.example",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.ts\"",
    "dev": "node src/index.ts",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "keywords": [
    "domain",
    "drop",
    "dropcatch",
    "registrar",
    "rdap",
    "porkbun",
    "namecheap",
    "cloudflare",
    "discord",
    "cli"
  ],
  "dependencies": {
    "commander": "^15.0.0",
    "undici": "^8.11.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
